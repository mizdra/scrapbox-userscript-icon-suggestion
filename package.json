{
  "name": "scrapbox-userscript-icon-suggestion",
  "version": "6.0.1",
  "description": "Scrapbox's UserScript to suggest and insert icons.",
  "homepage": "https://github.com/mizdra/scrapbox-userscript-icon-suggestion#readme",
  "bugs": {
    "url": "https://github.com/mizdra/scrapbox-userscript-icon-suggestion/issues"
  },
  "license": "MIT",
  "author": "mizdra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizdra/scrapbox-userscript-icon-suggestion.git"
  },
  "type": "module",
  "scripts": {
    "build": "rolldown -c",
    "watch": "rolldown -w -c",
    "lint": "run-s -c lint:*",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "lint-fix": "run-s -c lint-fix:*",
    "lint-fix:oxfmt": "oxfmt --write",
    "lint-fix:oxlint": "pnpm run lint:oxlint --fix",
    "test": "vitest"
  },
  "dependencies": {
    "asearch": "^1.0.1",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@mizdra/oxfmt-config": "^0.2.0",
    "@mizdra/oxlint-config": "^0.5.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rolldown": "^1.2.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.7.0",
      "onFail": "download"
    }
  }
}
